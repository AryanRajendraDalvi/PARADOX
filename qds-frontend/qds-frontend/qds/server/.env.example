# HOST=0.0.0.0 (the default) binds on every network interface so other PCs
# on the LAN can reach this server — do not change this to 127.0.0.1 unless
# you specifically want to block LAN access.
HOST=0.0.0.0
PORT=4000

# Comma-separated list of browser origins allowed to call POST /api/auth/login.
# '*' (the default) is fine for a LAN demo.
ALLOWED_ORIGINS=*
