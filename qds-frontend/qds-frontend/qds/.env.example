# Point these at the session server's real, reachable address — never
# localhost/127.0.0.1 if you're running across multiple PCs on a LAN.
#
# Example for a server running on 192.168.1.100:4000, reachable by every PC:
#   VITE_API_URL=http://192.168.1.100:4000
#   VITE_WS_URL=ws://192.168.1.100:4000
#
# Copy this file to .env (or .env.local) and fill in the real address, then
# restart `npm run dev` — Vite only reads env vars at startup.

VITE_API_URL=
VITE_WS_URL=
